{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "../../../build/desktop/bridge/polymech-bridge/": "bridge/",
      "../../../build/desktop/licenses/": "licenses/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      },
      "bundleVCRuntime": true
    }
  }
}
